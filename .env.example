# MiniFoundry — Docker Compose environment (copy to .env and adjust).
# Every variable has a working dev default in docker-compose.yml; this file
# documents them. NEVER ship these values to a shared deployment.

# ─── platform mode ───────────────────────────────────────────────────────
# true  = demo sandbox: anonymous callers resolve to admin, role simulator on
# false = shared mode: anonymous callers are locked out; AUTH_SECRET required
MF_DEMO_MODE=true

# ─── secrets ─────────────────────────────────────────────────────────────
# HMAC/JWT session signing secret (32+ random chars in shared mode).
AUTH_SECRET=<redacted>

# Machine-caller token (scheduler-style internal callers, x-service-token).
MF_SERVICE_TOKEN=<redacted>

# Postgres superuser password (compose-local only).
POSTGRES_PASSWORD=

# ─── observability ───────────────────────────────────────────────────────
RUST_LOG=info,sqlx=warn
# MF_LOG_FORMAT=json

# ─── service database URLs (set per-service in docker-compose.yml) ──────
# postgres://mf_auth:<redacted>@postgres:5432/minifoundry
# postgres://mf_catalog:<redacted>@postgres:5432/minifoundry
# postgres://mf_orchestration:<redacted>@postgres:5432/minifoundry
# postgres://mf_compute:<redacted>@postgres:5432/minifoundry
# postgres://mf_ontology:<redacted>@postgres:5432/minifoundry
# postgres://mf_governance:<redacted>@postgres:5432/minifoundry

# ─── service discovery (defaults match compose DNS names) ───────────────
# NATS_URL=nats://nats:4222
# AUTH_INTERNAL_URL=http://auth:8081
# CATALOG_INTERNAL_URL=http://catalog:8082
# ORCHESTRATION_INTERNAL_URL=http://orchestration:8083
# COMPUTE_INTERNAL_URL=http://compute:8084
# ONTOLOGY_INTERNAL_URL=http://ontology:8085
# GOVERNANCE_INTERNAL_URL=http://governance:8086
# PUBLIC_API_INTERNAL_URL=http://public-api:8087
