# Generate a private .env with: node scripts/configure-env.mjs
# Shared mode requires sign-in. Demo mode must be enabled explicitly.
MF_DEMO_MODE=false

# Use independently generated random values (at least 32 characters).
AUTH_SECRET=
MF_SERVICE_TOKEN=
POSTGRES_PASSWORD=
MF_AUTH_DB_PASSWORD=
MF_CATALOG_DB_PASSWORD=
MF_ORCHESTRATION_DB_PASSWORD=
MF_COMPUTE_DB_PASSWORD=
MF_ONTOLOGY_DB_PASSWORD=
MF_GOVERNANCE_DB_PASSWORD=
MF_SEED_DB_PASSWORD=

# Optional disposable demo accounts: leave blank to create no demo users.
# Generate for local tests with: node scripts/configure-env.mjs --demo-users
MF_DEMO_USER_PASSWORD=
RUST_LOG=info,sqlx=warn
